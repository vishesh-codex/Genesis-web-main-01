# ===========================================
# Genesis Platform - Environment Variables
# ===========================================

# --- Database (Choose ONE) ---

# Option 1: Railway MySQL
DB_HOST=roundhouse.proxy.rlwy.net
DB_USER=root
DB_PASSWORD=your_railway_mysql_password
DB_NAME=railway
DB_PORT=3306

# Option 2: Supabase PostgreSQL
SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Option 3: Supabase JS Client (for realtime/auth features)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- MongoDB (for Application Forms only) ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/genesis

# --- Authentication ---
JWT_SECRET=genesis_jwt_secret_key_2025

# --- AI Chatbot (Groq) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudflare R2 (File Uploads) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=genesis
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.genesis-quic.in

# --- App Config ---
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
